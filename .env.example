# Optional backend. Only use the public anon/publishable key in browser builds.
# Never expose a Supabase secret/service-role key in frontend code or VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Alternatively, for projects using the newer key format:
VITE_SUPABASE_PUBLISHABLE_KEY=
